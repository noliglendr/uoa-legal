---
title: "UOA Legal — Strategic Legal Counsel"
description: "Strategic counsel for organizations navigating growth, risk, compliance, disputes, contracts, international expansion, and leadership decisions."
layout: layouts/base.njk
extraScripts:
  - /assets/js/testimonials.js
---
{% from "macros/icons.njk" import icon %}

<header class="hero">
  <div class="hero-media" aria-hidden="true">
    <img src="/assets/images/hero-building.jpg" alt="" width="1920" height="1280" />
  </div>
  <div class="hero-overlay" aria-hidden="true"></div>
  <div class="wrap hero-content">
    <h1>Your most important business decisions deserve clear legal direction.</h1>
    <p class="hero-lede">UOA Legal provides strategic counsel for organizations navigating growth, risk, compliance, disputes, contracts, international expansion, and leadership decisions. We help you move forward with confidence.</p>
    <div class="hero-actions">
      <a href="/contact/" class="btn btn-gold">Discuss your situation</a>
      <a href="#practice" class="btn btn-ghost">Explore practice areas</a>
    </div>
  </div>
</header>

<section class="section" id="solve">
  <div class="wrap">
    <p class="eyebrow">What We Solve</p>
    <h2 class="section-title">Every business faces different legal challenges.</h2>
    <div class="card-grid three">
      {% for p in practices %}
      {% if p.showOnHome %}
      <article class="soft-card">
        <div class="icon-box">{{ icon(p.icon) }}</div>
        <h3>{{ p.shortTitle }}</h3>
        <p>{{ p.solveBlurb }}</p>
      </article>
      {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<section class="section section-muted" id="process">
  <div class="wrap">
    <div class="section-center">
      <p class="eyebrow">How We Work</p>
      <h2 class="section-title">From challenge to confident decision.</h2>
    </div>
    <ol class="process-row">
      {% for step in home.process %}
      <li class="process-step">
        <div class="process-icon">{{ icon(step.icon) }}</div>
        <span>{{ step.label }}</span>
      </li>
      {% endfor %}
    </ol>
  </div>
</section>

<section class="section" id="why">
  <div class="wrap why-grid">
    <div>
      <p class="eyebrow">Why UOA Legal</p>
      <h2 class="section-title">Better legal strategy starts with better business decisions.</h2>
      <ul class="why-list">
        {% for item in home.why %}
        <li>
          <strong>{{ item.title }}</strong>
          <p>{{ item.body }}</p>
        </li>
        {% endfor %}
      </ul>
    </div>
    <figure class="why-media">
      <img src="/assets/images/why-meeting.jpg" alt="Business leaders in a strategy meeting" width="1200" height="800" loading="lazy" />
    </figure>
  </div>
</section>

<section class="section section-white" id="practice">
  <div class="wrap">
    <p class="eyebrow">Practice Areas</p>
    <h2 class="section-title">Strategic counsel across every stage of business.</h2>
    <div class="card-grid three">
      {% for p in practices %}
      {% if p.showOnHome %}
      <article class="practice-panel">
        <div class="icon-inline">{{ icon(p.icon) }}</div>
        <p class="panel-audience">{{ p.audience }}</p>
        <h3>{{ p.title }}</h3>
        <p class="panel-stake">What's at stake: {{ p.stake }}</p>
        <p>{{ p.practiceBlurb }}</p>
        <a class="text-link" href="/practice-{{ p.slug }}/">Learn More <span aria-hidden="true">&rarr;</span></a>
      </article>
      {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<section class="stats-band" aria-label="Firm highlights">
  <div class="wrap">
    <h2 class="stats-heading">Trusted by businesses making bold decisions.</h2>
    <div class="stats-row">
      {% for stat in home.stats %}
      <div class="stat">
        <div class="stat-value">{{ stat.value }}</div>
        <div class="stat-label">{{ stat.label }}</div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section" id="voices">
  <div class="wrap">
    <div class="section-center">
      <p class="eyebrow">Client Voices</p>
      <h2 class="section-title serif-title">What our clients say.</h2>
    </div>
    <div class="testimonials" data-testimonials>
      <div class="testimonials-track" data-track>
        {% for t in home.testimonials %}
        <blockquote class="testimonial-card">
          <p>&ldquo;{{ t.quote }}&rdquo;</p>
          <footer>
            <cite>{{ t.name }}</cite>
            <span>{{ t.role }}</span>
          </footer>
        </blockquote>
        {% endfor %}
      </div>
      <div class="testimonial-controls">
        <button type="button" class="carousel-btn" data-prev aria-label="Previous testimonials">&#8249;</button>
        <button type="button" class="carousel-btn" data-next aria-label="Next testimonials">&#8250;</button>
      </div>
    </div>
  </div>
</section>

<section class="section section-white" id="founder">
  <div class="wrap founder-grid">
    <figure class="founder-media">
      <img src="{{ home.founder.image }}" alt="{{ home.founder.name }}" width="900" height="1350" loading="lazy" />
    </figure>
    <div class="founder-copy">
      <p class="eyebrow">Principal Attorney</p>
      <h2 class="founder-name">{{ home.founder.name }}</h2>
      <p class="founder-role">{{ home.founder.role }}</p>
      {% for para in home.founder.paragraphs %}
      <p>{{ para }}</p>
      {% endfor %}
      <a href="/about/" class="btn btn-dark">Meet Udoka Amah</a>
    </div>
  </div>
</section>

<section class="section" id="insights">
  <div class="wrap">
    <p class="eyebrow">Insights</p>
    <h2 class="section-title">Strategic perspectives for business leaders.</h2>
    <div class="card-grid three">
      {% for item in home.insights %}
      <article class="insight-card">
        <div class="insight-media">
          <img src="{{ item.image }}" alt="" width="900" height="600" loading="lazy" />
        </div>
        <p class="insight-category">{{ item.category }}</p>
        <h3>{{ item.title }}</h3>
        <p>{{ item.summary }}</p>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

<section class="closer-cta">
  <div class="wrap">
    <h2>Your next decision deserves clear legal direction.</h2>
    <a href="/contact/" class="btn btn-gold">Schedule a Consultation</a>
  </div>
</section>
